# ==========================================================================
# Atlas — environment configuration template
# Copy to `.env` (or run ./setup.sh) and fill in real values.
# Never commit `.env`. Production secrets come from Infisical (SecretOps).
# ==========================================================================

# --- General ----------------------------------------------------------------
APP_NAME=Atlas
# Public hosts (DNS + TLS provisioned by Cerulean / NPM Edge)
GIT_HOST=git.innotel.us              # Gitea — repo & development hosting
CHEF_HOST=chef.innotel.us            # Chef — AI app builder
CONVEX_HOST=convex.innotel.us        # Convex backend (public when apps deploy)
GITEA_ROOT_URL=https://git.innotel.us/

# --- Version pins -----------------------------------------------------------
GITEA_VERSION=1.27.2
POSTGRES_VERSION=16
CONVEX_VERSION=latest                # pin a release to reproduce (e.g. 0.0.0-...)

# --- Gitea (repo & development hosting) -------------------------------------
# Ports as seen from the host; override when another stack already binds them.
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=22
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change-me-gitea-db-password
GITEA_DISABLE_REGISTRATION=true      # signups go through Authentik SSO only

# --- Convex (self-hosted realtime backend — Chef's app-building target) -----
CONVEX_BACKEND_PORT=3210             # backend (also published to 127.0.0.1)
CONVEX_SITE_PORT=3211                # http-actions site proxy
CONVEX_DASHBOARD_PORT=6791           # dashboard (127.0.0.1)
CONVEX_INSTANCE_SECRET=change-me-convex-instance-secret
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=change-me-convex-admin-key   # from `make convex-key`
CONVEX_DASHBOARD_URL=http://127.0.0.1:6791

# --- OmniRoute (model gateway — the single model provider for Chef) ---------
# Shared gateway runs on Zeus (Group 2, mesh 10.10.2.1:20128). Atlas does
# not run its own instance. `make gateway-check` verifies reachability.
#
# Distro runs its own OmniRoute gateway in its compose stack (Group 5, Server 5);
# Atlas + Distro share the same upstream provider pool via the Zeus gateway for
# Chef codegen. Rotate provider keys in one OmniRoute dashboard.
OMNIROUTE_BASE_URL=http://10.10.2.1:20128/v1
OMNIROUTE_API_KEY=change-me-omniroute-api-key
OMNIROUTE_MODEL=auto

# --- Chef (AI app builder — built from upstream get-convex/chef) ------------
# docker compose --profile chef up -d   (requires services/chef from setup.sh)
# 4310 avoids the common Vite dev default (5173) — see docs/chef-auth-fork.md
CHEF_PORT=4310
# URL of the Atlas Convex backend Chef's own backend functions run on.
VITE_CONVEX_URL=http://127.0.0.1:3210
# Chef talks to the Convex *control plane* for account/OAuth + project
# provisioning. Fully self-hosted forks replace this with Authentik OAuth
# (see docs/Integrations.md — "Auth fork" and docs/chef-auth-fork.md). These
# are empty by default (fork §4): Chef must not leave the box for a core
# function. Hosted-plane dev sets them explicitly — this is the documented
# escape hatch.
VITE_PROVISION_HOST=
BIG_BRAIN_HOST=
# ── Chef auth fork plumbing (docs/chef-auth-fork.md, stage 3a) ─────────────
# Empty by default — behavior is unchanged until the fork code lands. The
# CHEF_OIDC_* names stay separate from Gitea's OIDC_* (client `atlas-gitea`).
# Provider: Cerulean Authentik OAuth2 application `atlas-chef`, redirect
# https://chef.<zone>/api/auth/callback.
CHEF_OIDC_ISSUER_URL=
CHEF_OIDC_CLIENT_ID=atlas-chef
CHEF_OIDC_CLIENT_SECRET=
CHEF_SESSION_SECRET=
# Fork 3b.2 provisioning localization (deployment-per-app). Set to enable
# local per-app Convex backends via the chef-provisioner service; leave empty
# for the hosted-plane behavior.
# CHEF_PROVISION_URL=http://chef-provisioner:9080
# CHEF_PROVISION_TOKEN=change-me-provisioner-token
#
# Static hosting for generated apps (chef-sites nginx, chef profile):
# CHEF_SITES_DIR=./data/chef-sites        # extracted site files (host path)
# CHEF_SITES_PORT=8082                    # host port for chef-sites
# CHEF_DEFAULT_SITE_SLUG=                 # optional site served at /
# CHEF_DOCKER_NETWORK=atlas_default
# CHEF_PROVISIONER_PORT=9080
IDP_ADMIN_GROUP=atlas-admins
# Model providers. Point at the OmniRoute gateway so one credential pool
# serves every codegen request (see docs/Integrations.md — "OmniRoute"):
OPENAI_API_KEY=change-me-omniroute-api-key
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# --- Authentik (OIDC identity provider — Cerulean's Authentik) --------------
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/atlas/
OIDC_CLIENT_ID=atlas-gitea
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_SCOPES="openid profile email groups"
IDP_ADMIN_GROUP=atlas-admins

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) -------------
# Cerulean is the stack's TrustOps platform: Authentik SSO (every Atlas login
# goes through it), DNS automation (RFC 2136 BIND nsupdate + TSIG), wildcard
# Let's Encrypt certs via DNS-01, and NPM Edge provisioning.
#
# Used by operator provisioning and the Atlas Authentik OIDC clients (Gitea +
# Chef). See docs/Deployment.md and docs/Integrations.md.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_BASE_DOMAIN=git.innotel.us
CERULEAN_ZONE=innotel.us
CERULEAN_WAN_DISCOVERY_URL=https://api.ipify.org

# --- Infisical (SecretOps) --------------------------------------------------
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ORG=Innotel

# --- SMTP (notifications) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Atlas <no-reply@git.innotel.us>"

# --- Misc -------------------------------------------------------------------
ATLAS_ADMIN_USER=darnel              # Gitea admin created on first boot
ATLAS_ADMIN_EMAIL=dhunter@innotel.us

# --- Magnate billing (RevenueOps — paid developer seats, optional) ---------
# Atlas consumes Magnate for paid developer-seat entitlements (optional).
# Magnate owns Stripe, plans and the revenue ledger; Atlas checks entitlements
# via server-to-server API calls and never holds Stripe keys.
#
#   ENTITLEMENTS_API_TOKEN — optional bearer token gating Magnate's
#                            /api/entitlements + /api/purchases (server-to-server).
#                            Set the same value on the Magnate side.
#   MAGNATE_URL            — base URL of the Magnate instance
#                            (e.g. https://magnate.innotel.us)
#
# Magnate is Cerulean/Authentik-first: subscriber accounts + passwords live in
# Cerulean's Authentik, not in Magnate's app DB.
MAGNATE_URL=
ENTITLEMENTS_API_TOKEN=

# --- Distro integration (git export, optional) ---------------------------
# Atlas is the CodeOps home; Distro is where apps are built live in the browser.
# When Distro exports a project to an Atlas/Gitea remote, Atlas receives the
# source and can scaffold a Convex backend for it via Chef.
#
# These are the values Distro uses to reach Atlas (set in Distro's .env):
#   ATLAS_URL        = https://atlas.innotel.us        (Distro-side)
#   ATLAS_GIT_REMOTE = git@atlas.innotel.us            (Distro-side)
#
# Atlas itself does not require these env vars to run; they are referenced in
# docs/atlas-integration.md for the shared Distro ↔ Atlas workflow.
