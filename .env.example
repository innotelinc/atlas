# ==========================================================================
# Atlas — environment configuration template
# Copy to `.env` (or run ./setup.sh) and fill in real values.
# Never commit `.env`.
#
# Production secrets come from Cerulean Vault (SecretOps). The secret keys below
# are `vault://<mount>/<path>#<key>` references, and ./scripts/setup.sh
# materializes them into the gitignored `.env` before any container reads one —
# Atlas is compose-and-images only, so setup is the only place a reference *can*
# be resolved (see the "Cerulean Vault" section at the bottom).
# ==========================================================================

# --- General ----------------------------------------------------------------
APP_NAME=Atlas
# Public hosts (DNS + TLS provisioned by Cerulean / NPM Edge)
GIT_HOST=git.innotel.us              # Gitea — repo & development hosting
CONVEX_HOST=convex.innotel.us        # Convex backend (public when apps deploy)
GITEA_ROOT_URL=https://git.innotel.us/

# --- Version pins -----------------------------------------------------------
GITEA_VERSION=1.27.2
POSTGRES_VERSION=16
CONVEX_VERSION=latest                # pin a release to reproduce (e.g. 0.0.0-...)

# --- Gitea (repo & development hosting) -------------------------------------
# Ports as seen from the host; override when another stack already binds them.
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=22
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
# Reference — seeded by ./scripts/vault-bootstrap.py, resolved by setup.sh.
GITEA_DB_PASSWORD=vault://cerulean/atlas#GITEA_DB_PASSWORD
GITEA_DISABLE_REGISTRATION=true      # signups go through Authentik SSO only

# --- Convex (self-hosted realtime backend — a deploy target for built apps) -
CONVEX_BACKEND_PORT=3210             # backend (also published to 127.0.0.1)
CONVEX_SITE_PORT=3211                # http-actions site proxy
CONVEX_DASHBOARD_PORT=6791           # dashboard (127.0.0.1)
CONVEX_INSTANCE_SECRET=vault://cerulean/atlas#CONVEX_INSTANCE_SECRET
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# The platform admin key. It stays here: Olympus's packaging is written never to
# read it, and a deployment-scoped key (`npx convex deploy-key create`) is what a
# build may use.
CONVEX_SELF_HOSTED_ADMIN_KEY=change-me-convex-admin-key   # from `make convex-key`
CONVEX_DASHBOARD_URL=http://127.0.0.1:6791
# Behind the edge, the address a browser reaches — this is the value a consumer
# sets as its own CONVEX_URL. Olympus's builder reads exactly that when a plan's
# data target is Convex (atlas/docs/stack.md, olympus/docs/site-publishing.md).
CONVEX_PUBLIC_URL=https://convex.innotel.us

# --- OmniRoute (model gateway — the platform's single provider pool) --------
# Shared gateway runs in Group 2 (`2-voice/`), on the gateway host 192.168.1.46.
# Atlas runs no instance of its own, and NO other platform does either: one
# provider pool, one place to rotate. `make gateway-check` verifies reachability.
#
# The target is the SSO proxy in front of the gateway (:20129), not the gateway's
# own port: Cerulean SSO is its only gate, so 20128 answers on that host's
# loopback and bridge alone, while the proxy exempts /v1 for API clients. On the
# gateway's own host the same door is http://host.docker.internal:20129/v1.
#
# Atlas holds these because a built app may be pointed at the gateway; the
# *building* itself happens in Olympus, which has its own pair.
OMNIROUTE_BASE_URL=http://192.168.1.46:20129/v1
OMNIROUTE_API_KEY=change-me-omniroute-api-key
OMNIROUTE_MODEL=auto

# --- Chef — RETIRED AS A BUILDER -------------------------------------------
# The CHEF_* keys that used to be documented here (CHEF_PORT, VITE_CONVEX_URL,
# BIG_BRAIN_HOST, CHEF_OIDC_*, CHEF_SESSION_SECRET, CHEF_SITES_*,
# CHEF_OMNIROUTE_*, CHEF_PROVISION_*) belonged to the `chef` profile, which
# Atlas no longer runs: one platform, one builder, and it is Olympus's engine
# (convergence plan §2/§8). The vendor-key placeholders that existed only to
# satisfy Chef's build-time `depscheck` are gone with it — Atlas holds no
# provider key at all now.
#
# `chef-provisioner/` and docs/chef-auth-fork.md remain in the tree as the
# record; nothing here reads them. See docs/stack.md.

# --- Authentik (OIDC identity provider — Cerulean's Authentik) --------------
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/atlas/
OIDC_CLIENT_ID=atlas-gitea
# Issued by Authentik (client `atlas-gitea`): store what Authentik printed with
# scripts/vault-migrate.py, then reference it — a locally random value for a
# credential Gitea and Authentik must agree on is a wrong value that looks like
# a working one.
#   OIDC_CLIENT_SECRET=vault://cerulean/atlas#OIDC_CLIENT_SECRET
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email groups"
IDP_ADMIN_GROUP=atlas-admins

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) -------------
# Cerulean is the stack's TrustOps platform: Authentik SSO (every Atlas login
# goes through it), DNS automation (RFC 2136 BIND nsupdate + TSIG), wildcard
# Let's Encrypt certs via DNS-01, and NPM Edge provisioning.
#
# Used by operator provisioning and the Atlas Authentik OIDC clients (Gitea +
# Chef). See docs/Deployment.md and docs/Integrations.md.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_BASE_DOMAIN=git.innotel.us
CERULEAN_ZONE=innotel.us
CERULEAN_WAN_DISCOVERY_URL=https://api.ipify.org

# --- Cerulean Vault (SecretOps — HashiCorp Vault, KV v2) --------------------
# Secrets live in Cerulean's Vault; `.env` carries `vault://` references, e.g.
#   GITEA_DB_PASSWORD=vault://cerulean/atlas#GITEA_DB_PASSWORD
# The platform runs Vault as `cerulean-vault`; this stack gets the path-scoped
# `atlas` policy (VAULT_PRODUCT_TOKENS=atlas over there), delivered as
# ./data/vault/token/atlas.token. Never the root token.
#
#   export VAULT_ADDR=http://vault:8200
#   export VAULT_TOKEN_FILE=./data/vault/token/atlas.token
#   python3 scripts/vault-bootstrap.py            # seed the generated secrets
#   python3 scripts/vault-migrate.py --dry-run    # what else would move
#   python3 scripts/vault-resolve.py --check      # every reference resolves
#
# The Vault-owned keys, and who mints them:
#   generated by scripts/vault-bootstrap.py — GITEA_DB_PASSWORD,
#                                            CONVEX_INSTANCE_SECRET
#   issued by Cerulean Authentik, stored with scripts/vault-migrate.py —
#                                            OIDC_CLIENT_SECRET
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TOKEN_FILE=./data/vault/token/atlas.token
VAULT_PREFIX=cerulean
VAULT_PATH=atlas
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=

# --- Infisical (SecretOps — LEGACY) -----------------------------------------
# Atlas ships no Infisical service (no compose profile, no services/infisical/),
# so there is no INFISICAL_* block to keep here. The predecessor store is
# documented in docs/stack.md and docs/Integrations.md as legacy; a deployment
# still holding secrets there moves them with scripts/vault-migrate.py, which
# reads the Infisical v3 API and writes KV v2. Nothing in this stack reads it.

# --- SMTP (notifications) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Atlas <no-reply@git.innotel.us>"

# --- Misc -------------------------------------------------------------------
ATLAS_ADMIN_USER=darnel              # Gitea admin created on first boot
ATLAS_ADMIN_EMAIL=dhunter@innotel.us

# --- Magnate billing (RevenueOps — paid developer seats, optional) ---------
# Atlas consumes Magnate for paid developer-seat entitlements (optional).
# Magnate owns Stripe, plans and the revenue ledger; Atlas checks entitlements
# via server-to-server API calls and never holds Stripe keys.
#
#   ENTITLEMENTS_API_TOKEN — optional bearer token gating Magnate's
#                            /api/entitlements + /api/purchases (server-to-server).
#                            Set the same value on the Magnate side.
#   MAGNATE_URL            — base URL of the Magnate instance
#                            (e.g. https://magnate.innotel.us)
#
# Magnate is Cerulean/Authentik-first: subscriber accounts + passwords live in
# Cerulean's Authentik, not in Magnate's app DB.
MAGNATE_URL=
ENTITLEMENTS_API_TOKEN=

# --- Distro integration (git export, optional) ---------------------------
# Atlas is the CodeOps home. The builder is Studio (Olympus); Distro is the
# tenancy service (accounts, per-user gateway keys, quota, audit) and no longer
# builds apps itself — its bolt.diy front door was retired in Phase 3.
# When a packaged project is pushed to an Atlas/Gitea remote, Atlas receives the
# source and can host a Convex backend for it.
#
# These are the values Distro uses to reach Atlas (set in Distro's .env):
#   ATLAS_URL        = https://atlas.innotel.us        (Distro-side)
#   ATLAS_GIT_REMOTE = git@atlas.innotel.us            (Distro-side)
#
# Atlas itself does not require these env vars to run; they are referenced in
# docs/atlas-integration.md for the shared Distro ↔ Atlas workflow.
